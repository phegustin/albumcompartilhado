// Schema da Galeria Compartilhada (foco 100% galeria — sem site dos noivos,
// sem Pix e sem RSVP).
//
// Regras deste arquivo:
//  - Tabelas e colunas em snake_case no banco (@@map / @map) para casar com o
//    padrao do Supabase e com o .md de especificacao.
//  - Todo DELETE em cascata: apagar um album apaga as midias, curtidas e
//    comentarios ligados a ele.
//  - Nenhuma migration destrutiva deve ser gerada sem autorizacao.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Tipos de evento atendidos pela plataforma.
enum EventType {
  WEDDING // Casamento
  SWEET_15 // 15 Anos
  GRADUATION // Formatura
  BIRTHDAY // Aniversario
  CORPORATE // Evento Corporativo
  OTHER
}

/// Paletas visuais selecionaveis pelo anfitriao.
enum AlbumTheme {
  OLIVE_GOLD // Olive & Gold
  CLASSIC_NOIR // Classic Noir
  TERRACOTTA // Terracotta
  ROSE_QUARTZ // Rose Quartz
  MIDNIGHT_PARTY // Midnight Party
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
}

/// "Momento" da festa em que a midia foi registrada.
enum CategoryTag {
  MAKING_OF // Making Of / Pre-festa
  CERIMONIA
  RECEPCAO
  PISTA // Pista de Danca
  RECADOS // Recados de Voz
}

enum MediaStatus {
  PENDING // Aguardando moderacao
  APPROVED // Visivel no feed e no telao
  HIDDEN // Ocultada pela moderacao
}

/// Um evento (casamento, 15 anos, formatura...). Cada um tem seu proprio slug.
model Album {
  id String @id @default(uuid())

  slug           String     @unique
  eventType      EventType  @default(WEDDING)
  title          String // Ex: "Helena & Gabriel"
  subtitle       String? // Ex: "Casamento • 15 de Novembro"
  eventDate      DateTime?
  coverUrl       String?
  theme          AlbumTheme @default(OLIVE_GOLD)

  // Modo Capsula do Tempo: convidados sobem durante a festa, mas o album so
  // e revelado para todos a partir de revealAt.
  capsuleMode Boolean   @default(false)
  revealAt    DateTime?

  // Se true, nenhuma midia aparece no telao antes de ser aprovada.
  requireModeration Boolean @default(false)

  // PINs numericos de 4 digitos (acesso sem login, por link + PIN).
  hostPin      String
  moderatorPin String

  // Marca white-label do rodape viral.
  studioBrandName String?
  studioWhatsapp  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mediaItems MediaItem[]

  @@map("albums")
}

/// Uma foto, video ou recado de voz enviado por um convidado.
model MediaItem {
  id String @id @default(uuid())

  albumId String @map("album_id")
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  uploaderName     String  @map("uploader_name") // Ex: "Tia Marcia"
  uploaderDeviceId String? @map("uploader_device_id") // localStorage do convidado

  mediaType   MediaType   @default(PHOTO) @map("media_type")
  categoryTag CategoryTag @default(RECEPCAO) @map("category_tag")

  // originalPath = caminho no bucket; originalUrl = URL publica do arquivo
  // 100% original (sem perda) para download dos anfitriaos.
  originalPath String? @map("original_path")
  originalUrl  String  @map("original_url")
  thumbUrl     String? @map("thumb_url") // WebP leve p/ feed e telao

  caption     String?
  durationSec Int?    @map("duration_sec") // Videos e recados de voz

  likesCount Int     @default(0) @map("likes_count")
  isPinned   Boolean @default(false) @map("is_pinned") // Destacado no topo
  status     MediaStatus @default(APPROVED)

  createdAt DateTime @default(now()) @map("created_at")

  likes    MediaLike[]
  comments MediaComment[]

  @@index([albumId, status, createdAt])
  @@index([albumId, categoryTag])
  @@index([albumId, isPinned, createdAt])
  @@map("media_items")
}

/// Curtida. A unique (media_id, device_id) impede o mesmo celular de curtir
/// a mesma midia duas vezes.
model MediaLike {
  id String @id @default(uuid())

  mediaId String    @map("media_id")
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  deviceId String @map("device_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([mediaId, deviceId])
  @@map("media_likes")
}

/// Comentario curto deixado por um convidado em uma midia.
model MediaComment {
  id String @id @default(uuid())

  mediaId String    @map("media_id")
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  authorName String @map("author_name")
  text       String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([mediaId, createdAt])
  @@map("media_comments")
}
