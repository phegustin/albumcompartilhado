# Copie este arquivo para .env e preencha.
# O .env NUNCA vai para o Git — só este modelo, que não tem segredo nenhum.

# ---------------------------------------------------------------------------
# Banco de dados (Postgres)
# ---------------------------------------------------------------------------
# Desenvolvimento — Postgres local; suba com: npm run db:start
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/albumcompartilhado?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/albumcompartilhado?schema=public"

# Producao — Supabase (projeto "albumcompartilhado", ref haudlsrxbjikfwofpdhh, sa-east-1).
# Pooler (6543) no DATABASE_URL; conexao direta (5432) no DIRECT_URL.
# A senha do banco foi definida na criacao do projeto e NAO fica aqui.
# DATABASE_URL="postgresql://postgres.haudlsrxbjikfwofpdhh:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.haudlsrxbjikfwofpdhh:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Storage das midias (fotos, videos, audios)
# ---------------------------------------------------------------------------
# Deteccao automatica quando vazio:
#   R2_* preenchidos  -> Cloudflare R2
#   Supabase preench. -> Supabase Storage
#   nada preenchido   -> local (public/uploads/, apenas desenvolvimento)
# STORAGE_DRIVER="local"
STORAGE_BUCKET="event-memories"

# --- Supabase (o bucket "event-memories" ja existe e e publico) ---
NEXT_PUBLIC_SUPABASE_URL=""            # https://<REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=""       # pode aparecer no navegador
SUPABASE_SERVICE_ROLE_KEY=""           # SOMENTE servidor — nunca exponha

# --- Cloudflare R2 (opcional) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""
R2_BUCKET="event-memories"

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=""                             # senha do Super Admin

# Endereco SECRETO do Super Admin. Fortemente recomendado em producao.
# Ex.: ADMIN_PATH="painel-x7f2k9"  ->  o painel passa a responder em
#      /painel-x7f2k9, e /admin devolve 404 (finge que nao existe).
# Assim nao ha uma porta visivel para ficarem tentando senha.
# ATENCAO: e lida no BUILD (rewrite do next.config.ts) e em runtime
# (middleware), entao precisa estar na Vercel antes do deploy.
ADMIN_PATH=""

# OPCIONAL. Só defina se o evento for num domínio próprio (ex: anaepedro.com.br).
# Se NÃO definir, o sistema descobre o endereço sozinho a partir da requisição
# (src/lib/base-url.ts) — e o QR Code funciona em localhost, no preview e em
# produção, sem você precisar trocar nada.
# NEXT_PUBLIC_SITE_URL="https://anaepedro.com.br"
