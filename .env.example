# Copie este arquivo para .env e preencha.
# O .env NUNCA vai para o Git — só este modelo, que não tem segredo nenhum.

# ---------------------------------------------------------------------------
# Banco de dados (Postgres)
# ---------------------------------------------------------------------------
# Desenvolvimento — Postgres local; suba com: npm run db:start
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/albumcompartilhado?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/albumcompartilhado?schema=public"

# Producao — Supabase (projeto "albumcompartilhado", ref haudlsrxbjikfwofpdhh, sa-east-1).
# Pooler (6543) no DATABASE_URL; conexao direta (5432) no DIRECT_URL.
# A senha do banco foi definida na criacao do projeto e NAO fica aqui.
# DATABASE_URL="postgresql://postgres.haudlsrxbjikfwofpdhh:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.haudlsrxbjikfwofpdhh:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Storage das midias (fotos, videos, audios)
# ---------------------------------------------------------------------------
# Deteccao automatica quando vazio:
#   R2_* preenchidos  -> Cloudflare R2
#   Supabase preench. -> Supabase Storage
#   nada preenchido   -> local (public/uploads/, apenas desenvolvimento)
# STORAGE_DRIVER="local"
STORAGE_BUCKET="event-memories"

# --- Supabase (o bucket "event-memories" ja existe e e publico) ---
NEXT_PUBLIC_SUPABASE_URL=""            # https://<REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=""       # pode aparecer no navegador
SUPABASE_SERVICE_ROLE_KEY=""           # SOMENTE servidor — nunca exponha

# --- Cloudflare R2 (opcional) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""
R2_BUCKET="event-memories"

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=""                             # senha do Super Admin

# Endereco SECRETO do Super Admin. Fortemente recomendado em producao.
# Ex.: ADMIN_PATH="painel-admin"  ->  o painel passa a responder em
#      /painel-admin, e /admin devolve 404 (finge que nao existe).
# Assim nao ha uma porta visivel para ficarem tentando senha.
# ATENCAO: e lida no BUILD (rewrite do next.config.ts) e em runtime
# (middleware), entao precisa estar na Vercel antes do deploy.
ADMIN_PATH=""

# O endereco OFICIAL do site. Todo QR Code, link curto e texto copiavel sai
# a partir daqui.
#
# POR QUE ISSO EXISTE: sem esta variavel, o sistema usa o endereco pelo qual a
# pessoa entrou (src/lib/base-url.ts, degrau 2). Parece esperto, mas vira
# armadilha na pratica — a Vercel da varios apelidos para o mesmo projeto:
#
#   album-compartilhado-tau.vercel.app                      (32 chars) <- o bom
#   album-compartilhado-phekolt-gmailcoms-projects.vercel.app (53 chars) <- o "Visit"
#
# Quem abre pelo botao "Visit" do painel entra pelo endereco de 53 caracteres,
# e o app obedientemente gera TODOS os links e QR Codes com ele. Fixando a
# variavel, o endereco passa a ser sempre o mesmo, nao importa por onde entrou.
#
# Na Vercel, isto e OBRIGATORIO e vale nos tres ambientes (production,
# preview, development). E lida no BUILD: mudar exige um deploy novo.
#
# Quando comprar o dominio proprio, troque APENAS esta linha e redeploy:
#   antes:  https://album-compartilhado-tau.vercel.app
#   depois: https://seudominio.com.br
# Nada de codigo muda — todo QR e link passa a apontar para o novo endereco.
#
# No AMBIENTE LOCAL deixe comentado: aí não existe endereço público fixo, e o
# degrau 2 (cabeçalhos) acerta tanto localhost:3000 quanto o túnel/preview.
# # NEXT_PUBLIC_SITE_URL="https://album-compartilhado-tau.vercel.app"
